# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.spec

# ── Virtual environment ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / secrets (NEVER commit real keys) ──────────────────
backend/.env
backend/.env.example
.env
.env.local
.env.*.local

# ── Database ─────────────────────────────────────────────────────────
*.db
*.sqlite3

# ── Data files (large CSVs generated by pipeline) ───────────────────
# Keep the directory structure but not the generated data
backend/data/macro_events/*.csv
backend/data/macro_events/*.json
# Exception: keep the example/seed files if any
!backend/data/macro_events/.gitkeep

# ── Node / Frontend ──────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
node_modules/

# ── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS generated ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── pytest / testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── mypy ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json



# ignored by dhrumil
.env
.env.*