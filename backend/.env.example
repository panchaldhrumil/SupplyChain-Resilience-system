# -----------------------------------------------------------------------
# backend/.env.example
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to version control.
# -----------------------------------------------------------------------

# Where live_macro_pipeline.py writes its CSVs (auto-created if missing).
# Both the pipeline AND the FastAPI API read from this same path.
# Default (leave blank to use backend/data/macro_events/):
# CSV_OUTPUT_DIR=D:\StockData\MACRO_EVENTS

# Where backend/config/ lives (buffer_config.json, import_mix.json, etc.)
# Default (leave blank to use backend/config/):
# CONFIG_DIR=

# -----------------------------------------------------------------------
# LLM - Google Gemini (Free Tier API)
# Required for: --llm-classify flag in live_macro_pipeline.py (sampled & capped)
#               ?llm_justify=true on /api/procurement-recommend (batched & cached)
#               GET /api/corridor-brief (RAG-grounded corridor news)
# Leave blank to run without LLM features (all other endpoints still work).
# -----------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------
# Agent loop configuration (optional - defaults shown)
# -----------------------------------------------------------------------
# AGENT_THRESHOLD=66          # corridor score level that triggers auto-alert
# AGENT_INTERVAL_SECONDS=300  # how often the background agent loop runs (5 min)
