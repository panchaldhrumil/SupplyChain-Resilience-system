CSV_OUTPUT_DIR=
CONFIG_DIR=

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Pooler URL (used by FastAPI / API server) — from Neon dashboard "Pooled connection"
DATABASE_URL=

# Direct / Unpooled URL (used by pipeline writes) — from Neon dashboard "Direct connection"
# Avoids Neon free-tier data-transfer quota errors on bulk inserts.
# If not set, DATABASE_URL is used as fallback.
DATABASE_URL_UNPOOLED=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=macro_events

AGENT_THRESHOLD=66
AGENT_INTERVAL_SECONDS=300
